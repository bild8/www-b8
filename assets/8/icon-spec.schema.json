  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256",
        "width",
        "height",
        "cdnUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(svg|png_32|png_192|png_526)/[a-z]8(_(32|192|526))?\\.(svg|png)$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "enum": [
            32,
            192,
            526
          ]
        },
        "height": {
          "type": "integer",
          "enum": [
            32,
            192,
            526
          ]
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 0
            },
            {
              "const": 192
            },
            {
              "const": 192
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "cdnUrl": {
          "type": "string",
          "pattern": "^https://bild8\\.de/assets/8/"
        }
      }
    }
