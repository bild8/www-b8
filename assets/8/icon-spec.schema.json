        "fontLock"
      ],
      "properties": {
        "script": {
          "const": "scripts/generate.mjs"
        },
        "node": {
          "const": "24.19.0"
        },
        "renderer": {
          "const": "@resvg/resvg-js"
        },
        "rendererVersion": {
          "const": "2.6.2"
        },
        "systemFonts": {
          "const": false
        },
        "fontLock": {
          "const": "fonts/source.json"
        }
      }
